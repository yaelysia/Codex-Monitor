{
  "name": "codex-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Codex session monitor for Windows, WSL and SSH",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "gpu:compat": "node scripts/configure-gpu.mjs compat",
    "gpu:software": "node scripts/configure-gpu.mjs software",
    "gpu:reset": "node scripts/configure-gpu.mjs default",
    "gpu:status": "node scripts/configure-gpu.mjs status",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:startup": "node --test tests/main-bundle.node.mjs",
    "test:gpu": "node --test tests/gpu-startup.node.mjs",
    "test:gpu:electron": "node --test tests/gpu-electron.node.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:probe": "node --test tests/app-server-probe.node.mjs",
    "probe:app-server": "node scripts/probe-app-server.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "probe:desktop-logs": "node scripts/probe-desktop-logs.mjs",
    "diagnose:tracking": "node scripts/diagnose-tracking.mjs",
    "diagnose:foreground": "node scripts/diagnose-foreground.mjs",
    "diagnose:questions": "node scripts/diagnose-questions.mjs",
    "diagnose:memory": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/diagnose-memory.ps1"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@radix-ui/react-select": "^2.2.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.yaelysia.codex-monitor",
    "productName": "Codex Monitor",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "collector/scan.py",
        "to": "scan.py"
      },
      {
        "from": "collector/preview.py",
        "to": "preview.py"
      },
      {
        "from": "collector/watch.py",
        "to": "watch.py"
      },
      {
        "from": "collector/window-tracker.ps1",
        "to": "window-tracker.ps1"
      },
      {
        "from": "collector/desktop-window-guard.ps1",
        "to": "desktop-window-guard.ps1"
      },
      {
        "from": "collector/tab-automation.cs",
        "to": "tab-automation.cs"
      },
      {
        "from": "collector/mobaxterm-tabs.cs",
        "to": "mobaxterm-tabs.cs"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
